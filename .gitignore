# Dependencies / build
node_modules/
# Keep dist/runtime committed optional — prefer npm run build in CI
# dist/ ignored only if regenerable; we commit dist/runtime for plugin consumers
*.log
.DS_Store

# OMG runtime state (project-local)
.omg/**
!.omg/skills/
!.omg/skills/**

# Local Grok / plugin config (machine-specific)
.grok/

# Test / hook temp dirs
.tmp/
.tmp-*/
tmp/

# Shellmark captured sessions (runtime dumps, not product source)
shellmark/sessions/

# Generated / binary seminar artifacts (source is seminar/slides.md)
seminar/*.pdf
seminar/screenshots/*
!seminar/screenshots/README.md

# Editor / local
.idea/
.vscode/
*.swp
.env
.env.*

# Generated bridge bundles (local/CI only — do not commit multi-MB cjs)
bridge/*.cjs
bridge/team.js
bridge/claude-md-coordinator.cjs
!bridge/README.md
!bridge/run-mcp-server.sh
!bridge/gyoshu_bridge.py

# Legacy OMC state (read-migrate only; never commit)
.omc/
